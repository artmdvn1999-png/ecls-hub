-- ESP Pet (Hiển thị thông tin Pet xuyên tường)
RunService.RenderStepped:Connect(function()
    if Settings.PetESP then
        local success, err = pcall(function()
            local eggsFolder = workspace:FindFirstChild("Eggs")
            if not eggsFolder then return end

            for _, egg in pairs(eggsFolder:GetChildren()) do
                if not egg:FindFirstChild("ESP_Tag") and egg:FindFirstChild("PrimaryPart") then
                    local Billboard = Instance.new("BillboardGui")
                    Billboard.Name = "ESP_Tag"
                    Billboard.Adornee = egg.PrimaryPart
                    Billboard.Size = UDim2.new(0, 100, 0, 50)
                    Billboard.AlwaysOnTop = true

                    local TextLab = Instance.new("TextLabel")
                    TextLab.Parent = Billboard
                    TextLab.BackgroundTransparency = 1
                    TextLab.Size = UDim2.new(1, 0, 1, 0)
                    TextLab.Font = Enum.Font.SourceSansBold
                    TextLab.TextColor3 = Color3.fromRGB(0, 255, 0)
                    TextLab.TextSize = 14
                    TextLab.Text = egg.Name

                    Billboard.Parent = egg
                end
            end
        end)
        if not success then
            warn("[ESP Error]: " .. tostring(err))
        end
    else
        -- Xóa ESP khi tắt
        pcall(function()
            for _, egg in pairs(workspace:FindFirstChild("Eggs") and workspace.Eggs:GetChildren() or {}) do
                if egg:FindFirstChild("ESP_Tag") then
                    egg.ESP_Tag:Destroy()
                end
            end
        end)
    end
end)

